{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VirtualCardToken",
  "type": "object",
  "required": ["token_id", "user_id", "parent_funding_card_id", "status"],
  "properties": {
    "token_id": { "type": "string" },
    "user_id": { "type": "string" },
    "parent_funding_card_id": { "type": "string" },
    "merchant_lock_id": { "type": ["string", "null"] },
    "dcvv_seed_key": { "type": "string" },
    "dcvv_refresh_interval_sec": { "type": "integer" },
    "usage_limit_amount": { "type": "integer" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ACTIVE", "EXHAUSTED", "REVOKED"] },
    "type": { "enum": ["SINGLE_USE", "MERCHANT_LOCKED", "SUBSCRIPTION", "DYNAMIC_CVV"] }
  }
}
