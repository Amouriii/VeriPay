{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/deploy/veripay.Dockerfile",
    "buildArgs": {
      "SERVICE": "ingress"
    }
  },
  "deploy": {
    "startCommand": "HTTP_PORT=${PORT:-8000} veripay-ingress",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
