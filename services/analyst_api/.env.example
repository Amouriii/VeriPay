# Service: analyst_api
LOG_LEVEL=INFO
GRPC_PORT=50051
HTTP_PORT=8000

# Downstream service endpoints.
VERIPAY_SUPERVISED_URL=http://supervised_model:8000
VERIPAY_ANOMALY_URL=http://anomaly_model:8000
VERIPAY_RISK_FUSION_URL=http://risk_fusion:8000
VERIPAY_DECISION_URL=http://decision_engine:8000
VERIPAY_INVESTIGATION_URL=http://investigation_agent:8000
VERIPAY_FEEDBACK_URL=http://feedback_loop:8000
VERIPAY_MODEL_MONITOR_URL=http://model_monitor:8000
VERIPAY_GRAPH_URL=http://graph_engine:8000

# Score-adjustment tuning.
TRUST_BOOST_FACTOR=0.7
HEIGHTENED_ALERT_ADD=0.1
GRADUAL_DRIFT_FACTOR=0.6
SUDDEN_DRIFT_FACTOR=1.2
TRUST_BOOST_WINDOW=3

# Network (graph) scoring axis weight in risk fusion (PLAN §12).
NETWORK_FUSION_WEIGHT=0.2

# Feature engine mode: basic (raw-signal model columns) or rich (the
# architecture's 16 causal-sequence features, mapped onto the model vector).
FEATURE_MODE=basic

# Four-quadrant refinement thresholds (architecture §6): when the cost-aware
# engine would BLOCK but the fraud probability is high while the anomaly score
# is low, the decision is downgraded to REVIEW_STEALTH (matches known fraud
# while looking normal) instead of an automatic freeze.
FRAUD_QUADRANT_THRESHOLD=0.5
ANOMALY_QUADRANT_THRESHOLD=0.5
