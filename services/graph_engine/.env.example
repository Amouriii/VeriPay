[TEMPLATE]
# Service: graph_engine
LOG_LEVEL=INFO
GRPC_PORT=50051
HTTP_PORT=8000

# Backfill the graph store at startup from the labeled dataset so every
# customer's full merchant history is present (PLAN §12). Empty disables it.
VERIPAY_GRAPH_SEED_CSV=/datasets/synthetic/transactions_labeled.csv
NETWORK_WINDOW_DAYS=30
