[TEMPLATE]
# Service: model_monitor
LOG_LEVEL=INFO
GRPC_PORT=50051
HTTP_PORT=8025

# Model under monitoring (registry model_name) and artifact locations.
MODEL_NAME=supervised
MODEL_DIR=/app/ml/models
MODEL_REGISTRY=/app/ml/models/registry.json
BASE_DATASET=/app/datasets/synthetic/transactions_labeled.csv

# Drift + retraining policy.
PSI_THRESHOLD=0.25
MIN_DRIFT_WINDOW=30
MIN_LABELED_OBSERVATIONS=10
PROMOTION_TOLERANCE=0.01
OBSERVATION_WINDOW=1000

# Feedback loop export endpoint (labels joined onto observations).
FEEDBACK_LOOP_URL=http://feedback_loop:8016
